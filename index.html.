<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bottola Football Club (BFC)</title>
    <style>
        /* General Styles - Navy Blue Theme */
        body { margin: 0; font-family: 'Arial', sans-serif; background-color: #f0f2f5; color: #333; }
        
        /* Header */
        header { background-color: #0a192f; color: white; padding: 20px; text-align: center; }
        .logo-img { width: 100px; height: auto; margin-bottom: 10px; border-radius: 50%; border: 3px solid white; }
        
        /* Navigation */
        nav { background-color: #112240; overflow: hidden; display: flex; justify-content: center; flex-wrap: wrap; position: sticky; top: 0; z-index: 1000; }
        nav a { color: white; padding: 14px 20px; text-decoration: none; text-align: center; font-weight: bold; }
        nav a:hover { background-color: #e62e2d; color: white; }

        /* Hero Section */
        .hero { 
            background-color: #0a192f; 
            color: white; 
            padding: 50px 20px; 
            text-align: center; 
            border-bottom: 5px solid #e62e2d;
        }
        .hero h1 { font-size: 2.5em; margin: 0; }
        .hero p { font-size: 1.2em; color: #ccc; }
        .btn { 
            background-color: #e62e2d; color: white; padding: 10px 25px; 
            text-decoration: none; font-weight: bold; border-radius: 30px; margin-top: 15px; display: inline-block;
        }

        /* Section Titles */
        .container { padding: 20px; max-width: 1200px; margin: auto; }
        .section-title { color: #0a192f; border-bottom: 3px solid #e62e2d; padding-bottom: 10px; margin-top: 40px; text-transform: uppercase; }
        
        /* Player Cards */
        .squad { display: flex; flex-wrap: wrap; gap: 15px; justify-content: center; }
        .card { 
            background: white; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); 
            width: 150px; text-align: center; padding: 15px; transition: transform 0.2s; border-top: 4px solid #0a192f;
        }
        .card:hover { transform: translateY(-5px); box-shadow: 0 6px 12px rgba(0,0,0,0.2); }
        .card h3 { margin: 10px 0 5px; font-size: 1em; font-weight: bold; }
        .jersey-no { background-color: #0a192f; color: white; padding: 3px 10px; border-radius: 15px; font-size: 0.8em; display: inline-block; margin-bottom: 5px; }
        
        /* Footer */
        footer { background-color: #0a192f; color: white; text-align: center; padding: 30px 20px; margin-top: 40px; }
    </style>
</head>
